# NA PÓŹNIEJ: obecna wersja działa na GitHub Pages bez formularza e-mail i nie używa tych zmiennych.
# Wzór zmiennych środowiskowych dla funkcji api/subscribe.js (hosting z funkcjami, np. Vercel).
# Prawdziwe wartości wpisz w panelu Vercel: Project → Settings → Environment Variables.
# NIE wpisuj tu prawdziwego klucza i NIE twórz pliku .env w repozytorium.

# Klucz API Brevo (Brevo → SMTP & API → API Keys). Sekret — tylko po stronie serwera.
BREVO_API_KEY=

# Numer listy, na którą trafią potwierdzone kontakty (Brevo → Contacts → Lists, kolumna ID).
BREVO_LIST_ID=

# Numer szablonu e-maila double opt-in (Brevo → Templates; szablon musi zawierać {{ params.DOIurl }}).
BREVO_DOI_TEMPLATE_ID=

# Strona, na którą Brevo przekieruje po kliknięciu linku potwierdzającego (musi być https://).
BREVO_DOI_REDIRECT_URL=https://twoja-nazwa.vercel.app/zapis-potwierdzony.html

# Opcjonalnie: adres strony, z której wolno wysyłać formularz (ochrona przed użyciem z innych stron).
ALLOWED_ORIGIN=https://twoja-nazwa.vercel.app
